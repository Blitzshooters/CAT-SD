{
	"info": {
		"_postman_id": "cat-sd-api-collection-v1",
		"name": "CAT SD API - Complete Collection",
		"description": "Koleksi lengkap Postman API untuk proyek Computer Assisted Test Sekolah Dasar (CAT-SD). Mencakup Autentikasi JWT, Pengambilan Ujian & Bank Soal, AI Proctoring, Manajemen Profil, serta Panel CRUD Admin.",
